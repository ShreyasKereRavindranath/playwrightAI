BASE_URL=https://your-app.example.com

BROWSER=chromium
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=30000
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

# Auto-install the Playwright browser on first run (no manual `playwright install`)
AUTO_INSTALL_BROWSERS=true
INSTALL_BROWSER_DEPS=false

TEST_USER_EMAIL=replace_with_test_user_email
TEST_USER_PASSWORD=replace_with_test_user_password

# ── AI / LLM ──────────────────────────────────────────────────────────────────
ENABLE_AI_HEALING=false
AI_MAX_TOKENS=2000

# Choose the active LLM provider (remembered in config/llm_selection.json; the UI
# can switch it at runtime). One of:
#   openai | anthropic | gemini | ollama | lmstudio | openai_compatible
AI_PROVIDER=openai

# Only the SELECTED provider's settings are required. Local providers (ollama,
# lmstudio) need no API key.
OPENAI_API_KEY=sk-replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# AI_MODEL is the legacy alias for OPENAI_MODEL (kept for backward compatibility)
AI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8
# GEMINI_API_KEY=...                 # or GOOGLE_API_KEY
# GEMINI_MODEL=gemini-2.5-flash
# OLLAMA_HOST=http://127.0.0.1:11434 # auto-installed/started; no key
# OLLAMA_MODEL=llama3.1
# LMSTUDIO_HOST=http://127.0.0.1:1234/v1
# OPENAI_COMPAT_BASE_URL=https://your-endpoint/v1
# OPENAI_COMPAT_API_KEY=...
# OPENAI_COMPAT_MODEL=your-model

# ── LLM cost/latency observability + guardrails (no API key needed) ───────────
# Record every LLM call (cost, tokens, latency, feature) to
# logs_and_reports/llm_usage.db; inspect with `python -m tools.llm_usage`.
LLM_OBSERVABILITY=true
# Per-process budget ceilings (0 = unlimited). When a ceiling is hit, further LLM
# calls are blocked and each AI feature falls back to its offline path.
LLM_MAX_COST_USD=0
LLM_MAX_TOKENS=0
LLM_MAX_CALLS=0
# Reuse identical prompts to cut cost/latency (persists across runs when on).
LLM_CACHE_ENABLED=false
# Model routing & fallback: try the cheapest model first, escalate on weak/empty
# output, fail over to the next configured provider on error.
LLM_ROUTING_ENABLED=false

# ── Capability: Flakiness Tracker (no API key needed) ─────────────────────────
FLAKINESS_TRACKING=true
FLAKINESS_WINDOW=20
FLAKINESS_THRESHOLD=0.15
# Quarantine known-flaky tests out of the gating run (run them via
# `pytest --quarantine-only`). AUTO_QUARANTINE auto-adds newly-flaky tests at
# session end, with an AI diagnosis when a provider is configured.
QUARANTINE_ENABLED=true
AUTO_QUARANTINE=false
# Persist each failure's message + traceback for root-cause clustering
# (python -m tools.triage). No API key needed; the AI label is optional.
FAILURE_TRACKING=true

# ── Capability: Visual Regression (no API key needed) ─────────────────────────
VISUAL_REGRESSION=false
VISUAL_DIFF_THRESHOLD=10

# ── Capability: Accessibility Audit (no API key needed) ───────────────────────
ACCESSIBILITY_AUDIT=false
ACCESSIBILITY_FAIL_ON=critical,serious

# ── Capability: Performance Metrics (no API key needed) ───────────────────────
PERFORMANCE_METRICS=false
PERFORMANCE_LCP_BUDGET_MS=2500
PERFORMANCE_LOAD_BUDGET_MS=5000

# ── Capability: AI Test Summary (requires OPENAI_API_KEY) ─────────────────────
AI_SUMMARY=false

# ── Capability: AI-Feature Eval Harness (no API key needed) ───────────────────
# `python -m tools.eval` scores the AI classifiers (heal/flaky/triage) against
# golden datasets in data/evals/. In --gate mode a suite fails CI when its
# accuracy drops more than this fraction below the recorded baseline.
EVAL_REGRESSION_THRESHOLD=0.05

# ── Capability: Extent-style HTML Report (no API key needed) ──────────────────
# Opt-in consolidated interactive report (pass/fail donut + category breakdown +
# filterable per-test cards). Functional → logs_and_reports/extent_report.html;
# load → each run's folder. Complements the pytest-html / Allure / JUnit output.
EXTENT_REPORT=false

# ── Capability: NL Generation Validate-and-Repair (uses the selected LLM) ─────
# After NL test generation, validate with `pytest --collect-only` and let the
# LLM self-correct on failure. Set NL_REPAIR_ENABLED=false to skip validation.
NL_REPAIR_ENABLED=true
NL_REPAIR_ATTEMPTS=2

# ── Capability: Slack / Teams Notifications ───────────────────────────────────
SLACK_NOTIFICATIONS=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/with/real
SLACK_CHANNEL=#qa-alerts
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/replace/with/real

# ── Reporting ─────────────────────────────────────────────────────────────────
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_ALL_TESTS=true
# Screenshot image format: webp (Playwright ≥1.62; ~60-80% smaller, auto-falls back
# to png on older builds) | png | jpeg. Quality 0-100 applies to webp/jpeg only.
SCREENSHOT_FORMAT=webp
SCREENSHOT_QUALITY=80
RECORD_VIDEO=true
TRACE_ON_FAILURE=true
# Auto-download the Allure CLI on first report view (no Homebrew/npm; needs a JRE).
# Falls back to the native pytest-html / Extent reports when unavailable.
ALLURE_AUTO_INSTALL=true
