BASE_URL=https://your-app.example.com

BROWSER=chromium
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=30000
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720

TEST_USER_EMAIL=replace_with_test_user_email
TEST_USER_PASSWORD=replace_with_test_user_password

# ── AI / LLM ──────────────────────────────────────────────────────────────────
ENABLE_AI_HEALING=false
OPENAI_API_KEY=sk-replace_with_your_openai_api_key
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000

# ── Capability: Flakiness Tracker (no API key needed) ─────────────────────────
FLAKINESS_TRACKING=true
FLAKINESS_WINDOW=20
FLAKINESS_THRESHOLD=0.15

# ── Capability: Visual Regression (no API key needed) ─────────────────────────
VISUAL_REGRESSION=false
VISUAL_DIFF_THRESHOLD=10

# ── Capability: Accessibility Audit (no API key needed) ───────────────────────
ACCESSIBILITY_AUDIT=false
ACCESSIBILITY_FAIL_ON=critical,serious

# ── Capability: Performance Metrics (no API key needed) ───────────────────────
PERFORMANCE_METRICS=false
PERFORMANCE_LCP_BUDGET_MS=2500
PERFORMANCE_LOAD_BUDGET_MS=5000

# ── Capability: AI Test Summary (requires OPENAI_API_KEY) ─────────────────────
AI_SUMMARY=false

# ── Capability: Slack / Teams Notifications ───────────────────────────────────
SLACK_NOTIFICATIONS=false
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/replace/with/real
SLACK_CHANNEL=#qa-alerts
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/replace/with/real

# ── Reporting ─────────────────────────────────────────────────────────────────
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_ALL_TESTS=true
RECORD_VIDEO=true
TRACE_ON_FAILURE=true
